<Window x:Class="Atletika.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Atlétikai verseny - Rajtszámok"
        Width="1440" Height="820"
        WindowStartupLocation="CenterScreen"
        Background="#F3F6FA" FontFamily="Segoe UI" FontSize="14">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="390"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= Fejléc ================= -->
        <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,20">
            <TextBlock Text="Atlétikai verseny" FontSize="28" FontWeight="Bold" Foreground="#19324D"/>
            <TextBlock Text="Versenyzők regisztrációja és rajtszámok kiosztása" Foreground="#52657A"
                       Margin="0,2,0,0"/>
        </StackPanel>

        <!-- ================= Bal oldal: Új versenyző ================= -->
        <Border Grid.Row="1" Grid.Column="0"
                Background="White" BorderBrush="#D4DDE7" BorderThickness="1"
                CornerRadius="8" Padding="16">
            <DockPanel LastChildFill="True">

                <!-- a gomb a panel aljára kerül -->
                <Button x:Name="btnRegisztral" DockPanel.Dock="Bottom" Content="REGISZTRÁL"
                        Height="36" Background="#DDEBFA"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                        Click="Regisztral_Click"/>

                <StackPanel>
                    <TextBlock Text="Új versenyző" FontSize="20" FontWeight="Bold" Foreground="#19324D"
                               Margin="0,0,0,12"/>

                    <TextBlock Text="Versenyző neve:" Margin="0,0,0,6"/>
                    <TextBox x:Name="txtNev" Height="32" Padding="6,0"
                             VerticalContentAlignment="Center" HorizontalContentAlignment="Left"/>

                    <TextBlock Text="Versenyszám:" Margin="0,14,0,6"/>
                    <ComboBox x:Name="cmbVersenyszam" Height="32" IsEditable="False"
                              VerticalContentAlignment="Center">
                        <ComboBoxItem Content="100 m"/>
                        <ComboBoxItem Content="200 m"/>
                        <ComboBoxItem Content="400 m"/>
                        <ComboBoxItem Content="800 m"/>
                        <ComboBoxItem Content="1500 m"/>
                        <ComboBoxItem Content="Távolugrás"/>
                        <ComboBoxItem Content="Magasugrás"/>
                        <ComboBoxItem Content="Súlylökés"/>
                    </ComboBox>

                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <TextBlock Text="Nem:" Width="60" VerticalAlignment="Center"/>
                        <RadioButton x:Name="rbFerfi" Content="Férfi" GroupName="Nem" Width="110"
                                     VerticalContentAlignment="Center"/>
                        <RadioButton x:Name="rbNo" Content="Nő" GroupName="Nem"
                                     VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <Grid Margin="0,20,0,4">
                        <TextBlock Text="Életkor:"/>
                        <TextBlock x:Name="txtEletkor" Text="18 év" HorizontalAlignment="Right"
                                   FontWeight="Bold" Foreground="#2563A6" Margin="0,0,10,0"/>
                    </Grid>
                    <Slider x:Name="sldEletkor" Minimum="18" Maximum="90" Value="18"
                            TickFrequency="1" IsSnapToTickEnabled="True" TickPlacement="BottomRight"
                            Margin="8,4,8,0"
                            ValueChanged="Eletkor_Valtozott"/>
                    <Grid Margin="0,2,0,0">
                        <TextBlock Text="18" FontSize="12" Foreground="#52657A"/>
                        <TextBlock Text="90" FontSize="12" Foreground="#52657A" HorizontalAlignment="Right"
                                   Margin="0,0,10,0"/>
                    </Grid>

                    <TextBlock Text="Korábbi eredmények" FontWeight="Bold" Foreground="#19324D"
                               Margin="0,18,0,8"/>
                    <CheckBox x:Name="chkOlimpiai" Content="Olimpiai csúcs (OR)" Margin="0,0,0,8"
                              VerticalContentAlignment="Center"/>
                    <CheckBox x:Name="chkVB" Content="Világcsúcs (VR)" Margin="0,0,0,8"
                              VerticalContentAlignment="Center"/>
                    <CheckBox x:Name="chkEB" Content="Európa-csúcs (ER)"
                              VerticalContentAlignment="Center"/>

                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Igényelt rajtszám:" VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <TextBox x:Name="txtRajtszam" Grid.Column="1" Height="32" Padding="6,0"
                                 VerticalContentAlignment="Center" HorizontalContentAlignment="Left"/>
                    </Grid>
                    <TextBlock Text="Üres mező: automatikus kiosztás." FontSize="12" Foreground="#52657A"
                               Margin="0,10,0,16"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ================= Jobb oldal: Regisztrált versenyzők ================= -->
        <Border Grid.Row="1" Grid.Column="1" Margin="20,0,0,0"
                Background="White" BorderBrush="#D4DDE7" BorderThickness="1"
                CornerRadius="8" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Regisztrált versenyzők" FontSize="20" FontWeight="Bold"
                           Foreground="#19324D" Margin="0,0,0,12"/>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,14">
                    <TextBlock Text="Eredményszűrő:" VerticalAlignment="Center" Margin="0,0,20,0"/>
                    <ComboBox x:Name="cmbRekordSzuro" Width="320" Height="32" IsEditable="False"
                              VerticalContentAlignment="Center" SelectedIndex="0"
                              SelectionChanged="Szuro_Valtozott">
                        <ComboBoxItem Content="Összes"/>
                        <ComboBoxItem Content="OR - olimpiai csúcs"/>
                        <ComboBoxItem Content="VR - világcsúcs"/>
                        <ComboBoxItem Content="ER - Európa-csúcs"/>
                    </ComboBox>
                </StackPanel>

                <DataGrid x:Name="dgVersenyzok" Grid.Row="2"
                          ItemsSource="{Binding Versenyzok, Mode=OneWay}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserReorderColumns="False"
                          CanUserSortColumns="True"
                          HeadersVisibility="Column"
                          SelectionUnit="FullRow"
                          SelectionMode="Single"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#E3E9F0"
                          RowHeight="32"
                          AlternationCount="2"
                          AlternatingRowBackground="#F4F7FB"
                          Background="White"
                          BorderBrush="#D4DDE7">

                    <!-- ezt a feladatlap kéri: közös fejlécstílus a ColumnHeaderStyle-ban -->
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#19324D"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Height" Value="38"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Rajtszám" Width="88"
                                            Binding="{Binding Rajtszam, Mode=OneWay}"/>
                        <DataGridTextColumn Header="Név" Width="*"
                                            Binding="{Binding Nev, Mode=OneWay}"/>
                        <DataGridTextColumn Header="Versenyszám" Width="160"
                                            Binding="{Binding Versenyszam, Mode=OneWay}"/>
                        <DataGridTextColumn Header="Nem" Width="70"
                                            Binding="{Binding Nem, Mode=OneWay}"/>
                        <DataGridTextColumn Header="Életkor" Width="80"
                                            Binding="{Binding Eletkor, Mode=OneWay}"/>
                        <DataGridCheckBoxColumn Header="OR" Width="80"
                                                Binding="{Binding OR, Mode=OneWay}"/>
                        <DataGridCheckBoxColumn Header="VR" Width="80"
                                                Binding="{Binding VR, Mode=OneWay}"/>
                        <DataGridCheckBoxColumn Header="ER" Width="80"
                                                Binding="{Binding ER, Mode=OneWay}"/>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Grid.Row="3" Margin="0,14,0,0" FontSize="13" Foreground="#52657A"
                           Text="OR = olimpiai csúcs     VR = világcsúcs     ER = Európa-csúcs"/>
            </Grid>
        </Border>

        <!-- ================= Lábléc ================= -->
        <Border Grid.Row="2" Grid.ColumnSpan="2" Margin="0,16,0,0"
                Background="White" BorderBrush="#D4DDE7" BorderThickness="1"
                CornerRadius="8" Padding="16">
            <Grid>
                <TextBlock x:Name="txtLetszam" Text="Látható: 0 / Összesen: 0" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="btnMentes" Content="FÁJLBA MENTÉS" Width="210" Height="32"
                            VerticalContentAlignment="Center" Click="Mentes_Click"/>
                    <Button x:Name="btnBetoltes" Content="FÁJLBÓL BETÖLTÉS" Width="210" Height="32"
                            Margin="16,0,0,0" VerticalContentAlignment="Center" Click="Betoltes_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>